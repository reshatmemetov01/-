-- "ru-ru" / "ru" → русский, всё остальное → английский
function T.LangFor(localeId)
	local code = string.lower(string.sub(localeId or "", 1, 2))
	if T.Strings[code] then
		return code
	end
	return "en"
end

function T.Get(lang, key)
	local dict = T.Strings[lang] or T.Strings.en
	return dict[key] or T.Strings.en[key] or key
end

-- Аргументы, начинающиеся с "@", тоже переводятся (например "@zone_2").
function T.Format(lang, key, args)
	local text = T.Get(lang, key)
	if args and #args > 0 then
		local resolved = {}
		for i, a in ipairs(args) do
			if type(a) == "string" and string.sub(a, 1, 1) == "@" then
				resolved[i] = T.Get(lang, string.sub(a, 2))
			else
				resolved[i] = tostring(a)
			end
		end
		local ok, res = pcall(string.format, text, table.unpack(resolved))
		if ok then
			return res
		end
	end
	return text
end

return T
