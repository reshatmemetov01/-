# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# ID администраторов через запятую (узнать свой ID: @userinfobot).
# Им приходят уведомления о заявках/оплатах и доступны /stats, /export, /broadcast
ADMIN_IDS=111111111

# Путь к базе SQLite
DB_PATH=pdd_bot.db

# Необязательно: токен платёжного провайдера (@BotFather -> Payments).
# Если пусто — вместо оплаты бот собирает заявку (имя + телефон).
PAYMENT_PROVIDER_TOKEN=
CURRENCY=RUB

# Username менеджера без @ (кнопка «Написать менеджеру»)
MANAGER_USERNAME=

# Ссылка, которую получает клиент после оплаты (закрытый канал, платформа курса и т.п.)
ACCESS_LINK=

# Множитель задержек дожимающих сообщений. 1 = как в сценарии (1 ч, 1 д, 3 д, 7 д).
# Для теста поставьте 0.0003 — вся цепочка пройдёт примерно за 3–4 минуты.
FOLLOWUP_DELAY_SCALE=1
