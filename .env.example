# ===== Обязательно =====

# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Твой Telegram ID (узнать: @userinfobot). Можно несколько через запятую.
# Только им видна кнопка «🛠 Админка» и приходят уведомления о покупках.
ADMIN_IDS=111111111

# ===== Каналы =====
# Проще НЕ заполнять: добавь бота администратором в группу/канал — он сам спросит,
# что это за чат, и запомнит выбор. Эти поля — запасной вариант.

# Ссылка на твой Telegram-канал. В приветствии будут кнопки «Подписаться» и «Продолжить»
# (подписка НЕ обязательна). Пусто — кнопки канала не будет.
CHANNEL_URL=

# ID закрытой группы с разборами и чатом (начинается с -100). Узнать: перешли любой пост
# из канала боту @getidsbot. Бот будет выдавать каждому купившему одноразовую ссылку.
PRIVATE_CHANNEL_ID=

# ===== Продажа =====

PRICE=1490
# Зачёркнутая «старая» цена в оффере (необязательно)
OLD_PRICE=
# Твой username без @ — для кнопки «💬 Поддержка» и текста оплаты
MANAGER_USERNAME=nothing409

# Многоразовая ссылка на оплату (Paydex → Платёжные ссылки → Многоразовая).
# Кнопка «Оплатить по СБП» ведёт на неё, под ней — «Я оплатил» (тебе приходит уведомление, ты подтверждаешь).
PAYMENT_URL=

# Временная оплата по СБП (пока не подключена Platega): реквизиты, которые увидит клиент.
# Перенос строки — \n. Если пусто — бот просит написать тебе в личку.
PAYMENT_DETAILS=Перевод по СБП на номер +7 900 000-00-00\nБанк: Т-Банк\nПолучатель: Эльдар

# ===== Прочее =====

DB_PATH=pdd_bot.db
QUESTIONS_PATH=data/questions.json
TIMEZONE=Europe/Moscow

# Множитель задержек дожимающих сообщений. 1 = как в сценарии.
# Для проверки поставь 0.005 — сообщения будут приходить примерно каждые 2 минуты.
FOLLOWUP_DELAY_SCALE=1
